# ── Wrks 관리 API (전 직원 PII 접근 가능 → 서버 전용, 브라우저 노출 금지) ──
WRKS_API_KEY=wrks_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WRKS_GATEWAY=https://gateway-api.wrks.ai

# ── AI 어댑터 ──
# AI_PROVIDER: mock | openai-compat | wrks
AI_PROVIDER=mock
# openai-compat / wrks 사용 시:
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4.1

# ── 인증 어댑터 ──
# AUTH_PROVIDER: email-directory (dev) | wrks-sso (prod, 암호화 키 확보 후)
AUTH_PROVIDER=email-directory
# 세션 쿠키 서명 시크릿 (배포 시 반드시 교체)
SESSION_SECRET=change-me-in-production
# wrks-sso 사용 시 Wrks에서 발급받는 암호화 키
WRKS_SSO_SECRET=

# ── 서버 ──
PORT=8080
# Apache ProxyPass 하위 경로 (예: /invention). 루트 배포 시 공란.
BASE_PATH=/invention
# 업로드 최대 크기 (바이트). 기본 25MB
MAX_UPLOAD_BYTES=26214400

# ── 경로 ──
TEMPLATE_PATH=../template/standard_form.pptx
OUTPUT_DIR=../output
PYTHON_BIN=./python/venv/bin/python
